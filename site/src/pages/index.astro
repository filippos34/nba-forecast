---
import Base from "../layouts/Base.astro";
import { load, etDate } from "../lib/data";
const model = load<any>("live/model.json", { date: null, games: [] });
const poly = load<any>("live/polymarket.json", { games: {} });
const cons = load<any>("live/consensus.json", { games: {}, min_books: 2 });
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base title="Today" active="">
  <h1 id="day">{model.date ? etDate(model.date) : "No games scheduled"}</h1>
  <p class="lede">The model's pre-game win probability for the home team, next to Polymarket (midpoint of the order book) and
    the market consensus: the median margin-removed probability across the sportsbooks we track, shown only when at least two
    are fresh. The model never sees any market price.</p>
  <div id="games" class="stack" data-base={base}
       data-initial={JSON.stringify({ model, polymarket: poly, consensus: cons })}>
    <noscript><p class="muted">The comparison needs JavaScript.</p></noscript>
  </div>
  <p class="small muted" style="margin-top:20px">Each figure shows when it was last confirmed; anything older than 90 minutes is greyed out.
    Updated hourly on game days (14:00–04:00 UTC). Margin: the model's expected point margin, derived from its win probability.
    <span id="refreshed"></span></p>
</Base>
<script>
  import { gameCard, loadLive, etTime } from "../lib/compare.js";
  const el = document.getElementById("games");
  const base = el.dataset.base;
  let data = JSON.parse(el.dataset.initial);
  const render = () => {
    const games = data.model?.games ?? [];
    el.innerHTML = games.length ? games.map((g) => gameCard({ ...g, early_label_games: data.model.early_label_games },
      data.polymarket, data.consensus)).join("") : `<p class="muted">No games scheduled.</p>`;
    document.getElementById("refreshed").textContent = data.model?.generated_at ? ` Model run ${etTime(data.model.generated_at)}.` : "";
    if (data.model?.date) document.getElementById("day").textContent = new Date(data.model.date + "T12:00:00Z")
      .toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" });
  };
  render();
  const refresh = async () => {
    const live = await loadLive(base);
    if (live.model) data = { model: live.model, polymarket: live.polymarket ?? data.polymarket, consensus: live.consensus ?? data.consensus };
    render();
  };
  refresh();
  setInterval(refresh, 10 * 60 * 1000);
  setInterval(render, 60 * 1000);          // ages and stale marks tick even between fetches
</script>
<style is:global>
  .stack { display: grid; gap: 14px; }
  .game-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; margin-bottom: 10px; }
  .game-head .when { color: var(--ink-2); font-size: 14px; }
  .game-head .matchup { font-size: 17px; }
  .game-head .tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .cmp-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 640px) { .cmp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .cmp-cell { border: 1px solid var(--rule-2); border-radius: 8px; padding: 8px 10px; }
  .cmp-cell.model { border-color: var(--s-model); }
  .cmp-label { font-size: 12px; color: var(--ink-2); }
  .cmp-value { font-size: 22px; font-weight: 650; font-variant-numeric: tabular-nums; }
  .cmp-sub, .cmp-asof { font-size: 12px; color: var(--ink-3); }
  .cmp-cell.stale { opacity: 0.45; }
  .cmp-cell.stale .cmp-asof { color: var(--ink-2); }
</style>
