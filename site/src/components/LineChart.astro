---
// Running metric over games: one line per series, shared y axis, crosshair + tooltip, legend + end labels.
interface Series { key: string; label: string; color: string; values: (number | null)[] }
interface Props { series: Series[]; xLabels: string[]; yLabel: string; id: string; height?: number }
const { series, xLabels, yLabel, id, height = 260 } = Astro.props;
const W = 760, H = height, m = { l: 52, r: 96, t: 12, b: 30 };
const all = series.flatMap((s) => s.values.filter((v): v is number => v !== null));
const lo = Math.min(...all), hi = Math.max(...all), pad = (hi - lo) * 0.1 || 0.01;
const y0 = lo - pad, y1 = hi + pad, n = xLabels.length;
const X = (i: number) => m.l + (n <= 1 ? 0 : (i / (n - 1)) * (W - m.l - m.r));
const Y = (v: number) => m.t + (1 - (v - y0) / (y1 - y0)) * (H - m.t - m.b);
const ticks = [0, 1, 2, 3, 4].map((k) => y0 + (k / 4) * (y1 - y0));
const path = (vals: (number | null)[]) => vals.map((v, i) => (v === null ? "" : `${i && vals[i - 1] !== null ? "L" : "M"}${X(i).toFixed(1)},${Y(v).toFixed(1)}`)).join("");
const payload = JSON.stringify({ x: xLabels, s: series.map((s) => ({ l: s.label, v: s.values })) });
---
<div class="chart" id={id} data-payload={payload}>
  <div class="legend">{series.map((s) => <span><i style={`background:${s.color}`}></i>{s.label}</span>)}</div>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={yLabel} style="width:100%;height:auto;display:block">
    {ticks.map((t) => (<g>
      <line x1={m.l} x2={W - m.r} y1={Y(t)} y2={Y(t)} stroke="var(--rule-2)" stroke-width="1" />
      <text x={m.l - 8} y={Y(t) + 4} text-anchor="end" font-size="11" fill="var(--ink-3)">{t.toFixed(3)}</text>
    </g>))}
    <text x={m.l} y={H - 8} font-size="11" fill="var(--ink-3)">{xLabels[0]}</text>
    <text x={W - m.r} y={H - 8} font-size="11" fill="var(--ink-3)" text-anchor="end">{xLabels[n - 1]}</text>
    {series.map((s) => (<path d={path(s.values)} fill="none" stroke={s.color} stroke-width="2" stroke-linejoin="round" />))}
    {series.map((s) => { const i = s.values.map((v, k) => [v, k]).filter(([v]) => v !== null).pop(); return i &&
      (<text x={X(i[1] as number) + 6} y={Y(i[0] as number) + 4} font-size="12" fill="var(--ink)">{s.label}</text>); })}
    <line class="xh" x1="0" x2="0" y1={m.t} y2={H - m.b} stroke="var(--ink-3)" stroke-width="1" visibility="hidden" />
    <rect class="hit" x={m.l} y={m.t} width={W - m.l - m.r} height={H - m.t - m.b} fill="transparent" />
  </svg>
  <div class="tip" role="status"></div>
</div>
<style>
  .chart { position: relative; }
  .tip { position: absolute; pointer-events: none; background: var(--surface); border: 1px solid var(--rule);
    border-radius: 6px; padding: 6px 8px; font-size: 12px; display: none; white-space: nowrap; color: var(--ink); }
</style>
<script define:vars={{ id, W, ml: m.l, mr: m.r }}>
  const el = document.getElementById(id), p = JSON.parse(el.dataset.payload);
  const svg = el.querySelector("svg"), xh = el.querySelector(".xh"), tip = el.querySelector(".tip"), n = p.x.length;
  el.querySelector(".hit").addEventListener("mousemove", (e) => {
    const r = svg.getBoundingClientRect(), sx = ((e.clientX - r.left) / r.width) * W;
    const i = Math.max(0, Math.min(n - 1, Math.round(((sx - ml) / (W - ml - mr)) * (n - 1))));
    const x = ml + (n <= 1 ? 0 : (i / (n - 1)) * (W - ml - mr));
    xh.setAttribute("x1", x); xh.setAttribute("x2", x); xh.setAttribute("visibility", "visible");
    tip.innerHTML = `<b>${p.x[i]}</b><br>` + p.s.map((s) => `${s.l}: ${s.v[i] === null ? "—" : s.v[i].toFixed(4)}`).join("<br>");
    tip.style.display = "block"; tip.style.left = Math.min(r.width - 160, (x / W) * r.width + 10) + "px"; tip.style.top = "30px";
  });
  el.querySelector(".hit").addEventListener("mouseleave", () => { xh.setAttribute("visibility", "hidden"); tip.style.display = "none"; });
</script>
