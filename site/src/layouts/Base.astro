---
import { load } from "../lib/data";
interface Props { title: string; description?: string; active?: string }
const { title, description = "An NBA win-probability model built only from game data, scored honestly in public.", active = "" } = Astro.props;
const meta = load<any>("meta.json", {});
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const nav = [
  ["", "Today"], ["season", "Season tracker"],
  ["experiments", "Experiments"], ["methodology", "Methodology"], ["players", "Players"],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · NBA Forecast Lab</title>
  <meta name="description" content={description} />
  <script is:inline>
    try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <style is:global>
    :root {
      --bg: #fcfcfb; --surface: #ffffff; --ink: #0b0b0b; --ink-2: #52514e; --ink-3: #75736e;
      --rule: #e4e2dc; --rule-2: #efeee9; --accent: #2a78d6;
      --s-model: #2a78d6; --s-poly: #eb6834; --s-base: #1baf7a; --muted-mark: #b9b7b0;
      color-scheme: light;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #1a1a19; --surface: #222220; --ink: #ffffff; --ink-2: #c3c2b7; --ink-3: #9a988f;
        --rule: #3a3936; --rule-2: #2c2b29; --accent: #3987e5;
        --s-model: #3987e5; --s-poly: #d95926; --s-base: #199e70; --muted-mark: #5c5b56;
        color-scheme: dark;
      }
    }
    :root[data-theme="dark"] {
      --bg: #1a1a19; --surface: #222220; --ink: #ffffff; --ink-2: #c3c2b7; --ink-3: #9a988f;
      --rule: #3a3936; --rule-2: #2c2b29; --accent: #3987e5;
      --s-model: #3987e5; --s-poly: #d95926; --s-base: #199e70; --muted-mark: #5c5b56;
      color-scheme: dark;
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin: 0; background: var(--bg); color: var(--ink);
      font: 16px/1.55 ui-sans-serif, -apple-system, "Segoe UI", Roboto, sans-serif; }
    a { color: var(--accent); text-underline-offset: 2px; }
    .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
    header.site { border-bottom: 1px solid var(--rule); background: var(--bg); position: sticky; top: 0; z-index: 10; }
    header.site .wrap { display: flex; align-items: center; gap: 16px; height: 56px; }
    .brand { font-weight: 700; color: var(--ink); text-decoration: none; white-space: nowrap; }
    nav.main { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; flex: 1; }
    nav.main a { color: var(--ink-2); text-decoration: none; padding: 6px 10px; border-radius: 6px; white-space: nowrap; font-size: 15px; }
    nav.main a[aria-current="page"] { color: var(--ink); background: var(--rule-2); font-weight: 600; }
    nav.main a:hover { color: var(--ink); }
    .theme-btn { border: 1px solid var(--rule); background: transparent; color: var(--ink-2); border-radius: 6px;
      padding: 4px 8px; cursor: pointer; font: inherit; font-size: 14px; }
    main { padding: 28px 0 56px; }
    h1 { font-size: 30px; line-height: 1.2; margin: 0 0 6px; letter-spacing: -0.01em; }
    h2 { font-size: 20px; margin: 36px 0 10px; }
    h3 { font-size: 16px; margin: 20px 0 6px; }
    .lede { color: var(--ink-2); margin: 0 0 24px; max-width: 70ch; }
    .muted { color: var(--ink-2); } .small { font-size: 14px; }
    .card { background: var(--surface); border: 1px solid var(--rule); border-radius: 10px; padding: 16px; }
    .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
    table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; font-size: 14px; }
    th, td { text-align: right; padding: 6px 8px; border-bottom: 1px solid var(--rule-2); }
    th:first-child, td:first-child { text-align: left; }
    th { color: var(--ink-2); font-weight: 600; font-size: 13px; }
    .table-scroll { overflow-x: auto; }
    .tag { display: inline-block; font-size: 12px; padding: 1px 7px; border-radius: 999px; border: 1px solid var(--rule); color: var(--ink-2); }
    .tag.ok { border-color: var(--s-base); } .tag.no { border-color: var(--muted-mark); }
    details summary { cursor: pointer; color: var(--ink-2); font-size: 14px; margin-top: 8px; }
    footer.site { border-top: 1px solid var(--rule); color: var(--ink-3); font-size: 13px; padding: 20px 0 32px; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 13px; color: var(--ink-2); margin: 6px 0 4px; }
    .legend i { display: inline-block; width: 12px; height: 3px; border-radius: 2px; vertical-align: middle; margin-right: 6px; }
    .legend i.dot { width: 9px; height: 9px; border-radius: 50%; }
  </style>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a class="brand" href={`${base}/`}>NBA Forecast Lab</a>
      <nav class="main" aria-label="Main">
        {nav.map(([href, label]) => (
          <a href={`${base}/${href}`} aria-current={active === href ? "page" : undefined}>{label}</a>
        ))}
      </nav>
      <button class="theme-btn" id="theme" type="button" aria-label="Toggle dark mode">◐</button>
    </div>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="site">
    <div class="wrap">
      Forecasts from a statistical model built only from game data. For research and education — not advice of any kind.
      Market comparisons use Polymarket (a public prediction market).
      {meta.generated_at && <> Data updated {new Date(meta.generated_at).toUTCString()}.</>}
    </div>
  </footer>
  <script is:inline>
    document.getElementById("theme").addEventListener("click", () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      root.dataset.theme = dark ? "light" : "dark";
      try { localStorage.setItem("theme", root.dataset.theme); } catch (e) {}
    });
  </script>
</body>
</html>
